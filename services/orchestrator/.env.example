# ==============================================================================
# Ghost Cursor Cloud Orchestrator — Environment Configuration
# ==============================================================================

# Server Port
PORT=8080

# ------------------------------------------------------------------------------
# Provider Selection: "mock" (offline default) or "vertex" (live Google Cloud)
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock

# ------------------------------------------------------------------------------
# Google Cloud Platform / Vertex AI Settings (Required when LLM_PROVIDER=vertex)
# ------------------------------------------------------------------------------
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
GEMINI_MODEL=gemini-2.0-flash

# Optional: Path to GCP Service Account JSON key (if not using 'gcloud auth application-default login')
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional: Direct Gemini API key (alternative to GCP ADC)
# GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# Tenant Service Credentials Map
# Format: credential1:tenant1,credential2:tenant2 (min 32 chars per credential)
# ------------------------------------------------------------------------------
GHOST_DEV_API_KEY=dev-test-key-minimum-32-characters-long
GHOST_DEV_TENANT_ID=shophive_demo

# Production multi-tenant format:
# GHOST_TENANT_CREDENTIALS=key1_at_least_32_chars_long:tenant_a,key2_at_least_32_chars_long:tenant_b
